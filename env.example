# Use a pooled PostgreSQL connection string from Neon in production.
DATABASE_URL=[REDACTED-SECRET]
NODE_ENV=development
PORT=4173
# Exact public origin, e.g. https://band-quantity-takeoff.vercel.app
APP_ORIGIN=http://localhost:4173
SESSION_DAYS=14
# Per-instance anti-abuse limit. Use a shared rate limiter for large multi-instance deployments.
AUTH_RATE_LIMIT=12
